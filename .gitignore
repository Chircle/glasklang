# ===========================================================
# Glasklang · .gitignore
# Hinweis: assets/js/firebase-config.js wird NICHT ignoriert –
# der Platzhalter muss im Repo bleiben (Demo-Modus + Deploy).
# ===========================================================

# --- Betriebssystem ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editoren & IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# --- Geheimnisse & lokale Konfiguration (nie committen) ---
.env
.env.*
!.env.example
*.local.js
*.local.json
serviceAccount*.json
*-service-account*.json
*firebase-adminsdk*.json
*.pem
*.key

# --- Firebase CLI & Emulator ---
.firebase/
firebase-debug.log*
firebase-debug.*.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
pubsub-debug.log*
emulator-data/
.runtimeconfig.json

# --- Daten-Exporte & Backups (können Songtexte/Notizen enthalten) ---
backups/
exports/
*.backup.json
firestore-export*/

# --- Node / Tooling ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.cache/

# --- Python (lokaler Testserver / Skripte) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Tests & Screenshots ---
playwright-report/
test-results/
coverage/
screenshots/
shots/

# --- Build- & Archivdateien ---
dist/
build/
*.zip
*.tgz

# --- Sonstiges ---
*.log
*.tmp